# GatePool Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mock mode (set to 'true' for development without Supabase)
VITE_USE_MOCK=false

# Allowed email domain for signup (used on login page)
VITE_ALLOWED_EMAIL_DOMAIN=college.edu

# Turnstile CAPTCHA (optional, for production)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key